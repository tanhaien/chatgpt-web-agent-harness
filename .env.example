# Copy to .env or set these in your shell before `npm start`.
# (.env is gitignored — never commit real values.)

# MCP server port
PORT=8787
# Bind address (keep loopback)
AGENT_HOST=127.0.0.1

# REQUIRED: folder the agent may read/write
AGENT_WORKSPACE=C:\path\to\your\repo
# Optional extra roots, semicolon-separated
AGENT_EXTRA_ROOTS=
# Optional extra roots as JSON. Prefer this when paths contain ':' or ';'.
# AGENT_EXTRA_ROOTS_JSON=["C:\\path\\one","D:\\path\\two"]
# Set 0 in tests/ephemeral servers so set_workspace does not rewrite server/.env.
LCA_PERSIST_WORKSPACE_ENV=1

# safe (recommended) | full
AGENT_MODE=safe
# strict (read-only) | balanced (risky actions require local approval) | full
AGENT_POLICY=balanced
# Set to 1 only if you really want catastrophic system commands allowed
# AGENT_ALLOW_DANGEROUS=1

# Optional bearer token. If set, /mcp requires: Authorization: Bearer <token>
MCP_AUTH_TOKEN=
# Optional comma-separated browser origins. Empty rejects browser-origin MCP calls.
MCP_ALLOWED_ORIGINS=
# Optional operator secret for MCP-based approval. Prefer the local dashboard.
AGENT_APPROVAL_TOKEN=
# Exact approvals expire quickly; accepted range is 1-30 minutes.
AGENT_APPROVAL_TTL_MINUTES=10

# Maximum combined text returned by one read_many call.
AGENT_MAX_BATCH_READ_CHARS=500000

# Durable executor: opencode (default) | blocked (CI/emergency fallback)
LCA_ORCHESTRATION_EXECUTOR=opencode
# OpenCode CLI/config/model used by the loopback HTTP sidecar.
LCA_OPENCODE_COMMAND=opencode
# Leave empty to use ~/.config/opencode/opencode.json
LCA_OPENCODE_CONFIG=
LCA_OPENCODE_MODEL=opencode-go/deepseek-v4-pro
# Optional fixed agent. Empty maps planner -> plan and other roles -> build.
LCA_OPENCODE_AGENT=

# Multi-MCP Gateway. Set 0 to disable (useful in isolated CI fixtures).
LCA_MCP_GATEWAY=1
# Leave empty to use ~/.config/opencode/opencode.json
LCA_MCP_CONFIG_PATH=
# Comma-separated provider IDs from the OpenCode MCP config.
LCA_MCP_PROVIDER_ALLOWLIST=contextplus,code-review-graph,lightpanda,mempalace,tool-attention,vibe-trading,vn-data,codebase-memory-mcp

# Local-only metrics dashboard (0 disables). Do NOT use 8788 (OpenAI tunnel uses it).
DASHBOARD_PORT=8790
DASHBOARD_HOST=127.0.0.1
# Optional comma-separated browser origins allowed to call dashboard APIs.
# Example for Tailscale Serve:
# DASHBOARD_ALLOWED_ORIGINS=https://my-node.example-tailnet.ts.net:8444
DASHBOARD_ALLOWED_ORIGINS=
